# ============================================
# AI Flow Lab - Environment Configuration
# ============================================

# LLM_MODE determines how AI agents interact
# Options:
#   "app" - Use ChatGPT desktop application (recommended)
#   "api" - Use OpenAI/Gemini REST APIs
LLM_MODE=app

# ============================================
# API Mode Settings
# Only used when LLM_MODE=api
# ============================================

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Configuration (used for critique step)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash-lite

# Anthropic/Claude Configuration (used for execute step when executor=claude)
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================
# Dashboard Configuration
# ============================================

# Port for the web dashboard
PORT=3847

# Enable dashboard authentication (optional)
# DASHBOARD_PASSWORD=

# ============================================
# Logging Configuration
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json, text
LOG_FORMAT=text

# ============================================
# Rate Limiting (API Mode)
# ============================================

# Maximum requests per minute
RATE_LIMIT_PER_MINUTE=30

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# ============================================
# Task Configuration
# ============================================

# Default timeout for task execution (seconds)
TASK_TIMEOUT=3600

# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=3

# ============================================
# Git Configuration
# ============================================

# Git author email for commits
GIT_AUTHOR_EMAIL=ai-flow-lab@localhost

# Git author name for commits
GIT_AUTHOR_NAME=AI Flow Lab

# Automatically commit state changes
AUTO_COMMIT_STATE=true

# ============================================
# Advanced Settings
# ============================================

# Development mode (verbose logging, reload on file change)
DEVELOPMENT=false

# Allow unsafe operations (for testing only)
ALLOW_UNSAFE_OPERATIONS=false
