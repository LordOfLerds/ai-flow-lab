# LLM Mode: "api" (uses API keys) or "app" (uses ChatGPT desktop app)
LLM_MODE=app

# Only needed in API mode:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ChatGPT Browser Worker (optional, for APP mode automation)
# Set to a specific ChatGPT conversation URL to reuse project context:
# CHATGPT_CHAT_URL=https://chatgpt.com/c/your-conversation-id

# Dashboard
PORT=3847
